      "status": "completed",
      "input": {
       "content": "import sqlite3, json, sys, datetime\n\nDB = r'C:\\Users\\x2\\.local\\share\\opencode\\opencode.db'\ncon = sqlite3.connect(DB)\ncon.row_factory = sqlite3.Row\ncur = con.cursor()\n\ndef get_sessions():\n    cur.execute(\"SELECT id, title, directory, time_created, time_updated, agent, model FROM session ORDER BY time_updated DESC\")\n    return [dict(r) for r in cur.fetchall()]\n\ndef get_messages(sid):\n    cur.execute(\"SELECT id, time_created FROM message WHERE session_id=? ORDER BY time_created\", (sid,))\n    out = []\n    for r in cur.fetchall():\n        mid = r['id']\n        cur.execute(\"SELECT data FROM part WHERE message_id=? ORDER BY time_created\", (mid,))\n        parts = []\n        for p in cur.fetchall():\n            try:\n                pd = json.loads(p['data'])\n            except Exception:\n                continue\n            parts.append(pd)\n        out.append({'message_id': mid, 'role': None, 'time': r['time_created'], 'parts': parts})\n    return out\n\nmode = sys.argv[1] if len(sys.argv) > 1 else 'info'\nsess = get_sessions()\nfor s in sess:\n    s['time_created'] = datetime.datetime.fromtimestamp(s['time_created']/1000).isoformat() if s['time_created'] else None\n    s['time_updated'] = datetime.datetime.fromtimestamp(s['time_updated']/1000).isoformat() if s['time_updated'] else None\n\nif mode == 'info':\n    for s in sess:\n        print(f\"{s['id']} | {s['time_updated']} | {(s['title'] or '')[:40]} | {s['directory']}\")\nelif mode == 'export':\n    sid = sys.argv[2]\n    msgs = get_messages(sid)\n    out = {'session_id': sid, 'messages': msgs}\n    path = r'D:\\AI_Project\\projects\\video\\chat_export.json'\n    with open(path, 'w', encoding='utf-8') as f:\n        json.dump(out, f, ensure_ascii=False, indent=1)\n    print(\"WROTE\", path, len(msgs), \"messages\")",

       "content": "import sqlite3, json\n\nDB = r'C:\\Users\\x2\\.local\\share\\opencode\\opencode.db'\ncon = sqlite3.connect(DB)\ncon.row_factory = sqlite3.Row\ncur = con.cursor()\n\n# sessions in D:/AI_Project\ncur.execute(\"SELECT id, title, time_updated FROM session WHERE directory LIKE 'D:/AI_Project%' ORDER BY time_updated DESC\")\nsids = [dict(r) for r in cur.fetchall()]\n\nfor s in sids[:25]:\n    sid = s['id']\n    cur.execute(\"SELECT data FROM message WHERE session_id=? ORDER BY time_created\", (sid,))\n    msgs = []\n    for r in cur.fetchall():\n        try:\n            msgs.append(json.loads(r['data']))\n        except Exception:\n            pass\n    # print role + first chunk text\n    firsts = []\n    for m in msgs:\n        role = m.get('role', m.get('info', {}).get('role', '?'))\n        txts = []\n        for p in m.get('parts', []):\n            if p.get('type') == 'text':\n                t = p.get('text', '').strip()\n                if t:\n                    txts.append(t[:70])\n                    break\n        firsts.append(f\"{role}: {txts[0] if txts else ''}\")\n    print(f\"=== {s['title'][:50]} | {len(msgs)} msgs\")\n    for f in firsts[:4]:\n        print(\"   \", f)\n    print()",

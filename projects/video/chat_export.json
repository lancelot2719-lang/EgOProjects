     "state": {
      "status": "completed",
      "input": {
       "content": "import sqlite3, json, os, sys, datetime\n\nDB = r'C:\\Users\\x2\\.local\\share\\opencode\\opencode.db'\n\ndef ts(ms):\n    if not ms: return None\n    return datetime.datetime.fromtimestamp(ms/1000).isoformat()\n\ncon = sqlite3.connect(DB)\ncon.row_factory = sqlite3.Row\ncur = con.cursor()\n\n# list sessions\ncur.execute(\"SELECT id, title, directory, time_created, time_updated, model, agent FROM session ORDER BY time_updated DESC\")\nsessions = [dict(r) for r in cur.fetchall()]\nfor s in sessions:\n    s['time_created'] = ts(s['time_created'])\n    s['time_updated'] = ts(s['time_updated'])\n    s['title'] = s['title'] or ''\n\nmode = sys.argv[1] if len(sys.argv) > 1 else 'info'\n\nif mode == 'info':\n    print(json.dumps(sessions, ensure_ascii=False, indent=1))\nelif mode == 'export':\n    sid = sys.argv[2]\n    cur.execute(\"SELECT data FROM message WHERE session_id=? ORDER BY time_created\", (sid,))\n    messages = []\n    for r in cur.fetchall():\n        try:\n            data = json.loads(r['data'])\n        except Exception:\n            data = {'raw': r['data']}\n        messages.append(data)\n    out = {'session_id': sid, 'messages': messages}\n    with open(os.path.join(r'D:\\AI_Project', 'chat_export_' + sid + '.json'), 'w', encoding='utf-8') as f:\n        json.dump(out, f, ensure_ascii=False, indent=1)\n    print(\"WROTE\", len(messages), \"messages\")\n",

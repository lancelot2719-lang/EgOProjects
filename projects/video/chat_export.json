     "state": {
      "status": "completed",
      "input": {
       "content": "import sqlite3, os, json, base64, ctypes, ctypes.wintypes\n\n# Read encryption key from Local State\nlocal_state_path = os.path.join(os.environ['LOCALAPPDATA'], 'Google', 'Chrome', 'User Data', 'Local State')\nwith open(local_state_path, 'r', encoding='utf-8') as f:\n    local_state = json.load(f)\n\nencrypted_key = base64.b64decode(local_state['os_crypt']['encrypted_key'])\n# Remove 'DPAPI' prefix (5 bytes)\nencrypted_key = encrypted_key[5:]\n\n# Decrypt with DPAPI\nDPAPI_CRYPTPROTECT_UI_FORBIDDEN = 0x01\n\nclass DATA_BLOB(ctypes.Structure):\n    _fields_ = [('cbData', ctypes.wintypes.DWORD), ('pbData', ctypes.POINTER(ctypes.c_char))]\n\ndef dpapi_decrypt(data):\n    blob_in = DATA_BLOB(len(data), ctypes.create_string_buffer(data, len(data)))\n    blob_out = DATA_BLOB()\n    if ctypes.windll.crypt32.CryptUnprotectData(ctypes.byref(blob_in), None, None, None, None, DPAPI_CRYPTPROTECT_UI_FORBIDDEN, ctypes.byref(blob_out)):\n        result = ctypes.string_at(blob_out.pbData, blob_out.cbData)\n        ctypes.windll.kernel32.LocalFree(blob_out.pbData)\n        return result\n    return None\n\naes_key = dpapi_decrypt(encrypted_key)\nif not aes_key:\n    print(\"Failed to decrypt AES key\")\n    exit(1)\nprint(f\"AES key length: {len(aes_key)}\")\n\n# Decrypt cookies using AES-256-GCM\nfrom Cryptodome.Cipher import AES\n\ndef decrypt_cookie(encrypted_value, key):\n    if encrypted_value[:3] == b'v10' or encrypted_value[:3] == b'v20':\n        # v10/v20: nonce = encrypted_value[3:15], ciphertext = encrypted_value[15:-16], tag = encrypted_value[-16:]\n        nonce = encrypted_value[3:15]\n        ciphertext = encrypted_value[15:-16]\n        tag = encrypted_value[-16:]\n        \n        # Need the key prefix for v10\n        if encrypted_value[:3] == b'v10':\n            cipher = AES.new(key, AES.MODE_GCM, nonce=nonce)\n        else:\n            cipher = AES.new(key, AES.MODE_GCM, nonce=nonce)\n        \n        try:\n            plaintext = cipher.decrypt_and_verify(ciphertext, tag)\n            return plaintext.decode('utf-8')\n        except Exception:\n            return None\n    return None\n\n# Process cookies\nconn = sqlite3.connect(r'D:\\AI_Project\\Video\\chrome_cookies.db')\nc = conn.cursor()\nc.execute(\"\"\"SELECT host_key, name, encrypted_value, path, expires_utc, is_secure \n             FROM cookies \n             WHERE host_key LIKE '%youtube%' OR host_key LIKE '%google%'\"\"\")\ncookies = c.fetchall()\n\nout = r'D:\\AI_Project\\Video\\fresh_cookies.txt'\ndecrypted_count = 0\nwith open(out, 'w', encoding='utf-8') as f:\n    f.write(\"# Netscape HTTP Cookie File\\n\\n\")\n    for host, name, enc_val, path, expires, secure in cookies:\n        value = decrypt_cookie(enc_val, aes_key)\n        if value is None:\n            value = \"\"\n        else:\n            decrypted_count += 1\n        \n        s = \"TRUE\" if secure else \"FALSE\"\n        init_dot = \"TRUE\" if host.startswith('.') else \"FALSE\"\n        if expires and expires > 0:\n            exp = str(int(expires / 1000000) - 11644473600)\n        else:\n            exp = \"0\"\n        f.write(f\"{host}\\t{init_dot}\\t{path}\\t{s}\\t{exp}\\t{name}\\t{value}\\n\")\n\nprint(f\"Decrypted {decrypted_count}/{len(cookies)} cookies\")\nprint(f\"Output: {out}\")\nconn.close()\n",
       "filePath": "D:\\AI_Project\\decrypt_cookies.py"

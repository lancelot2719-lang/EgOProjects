       "filePath": "D:\\AI_Project\\get_tabs.py",
       "content": "import json\nimport os\nimport sqlite3\nimport shutil\nimport tempfile\n\nprofile = os.path.join(os.environ['LOCALAPPDATA'], 'Google', 'Chrome', 'User Data', 'Default')\n\n# Method 1: Read Current Tabs from Preferences\nprefs_path = os.path.join(profile, 'Preferences')\ntabs_found = []\n\ntry:\n    with open(prefs_path, 'r', encoding='utf-8') as f:\n        prefs = json.load(f)\n    \n    # Check saved session tabs\n    if 'session' in prefs and 'startup_urls' in prefs['session']:\n        for url in prefs['session']['startup_urls']:\n            if 'youtube.com' in url or 'youtu.be' in url:\n                tabs_found.append(('startup', url))\n    \n    # Check last known tabs\n    if 'profile' in prefs and 'last_known_urls' in prefs['profile']:\n        for url in prefs['profile']['last_known_urls']:\n            if 'youtube.com' in url or 'youtu.be' in url:\n                tabs_found.append(('last_known', url))\nexcept Exception as e:\n    print(f\"Preferences error: {e}\")\n\n# Method 2: Read History DB for recent YouTube visits\nhistory_db = os.path.join(profile, 'History')\ntmp_history = os.path.join(tempfile.gettempdir(), 'chrome_history_copy.db')\n\ntry:\n    shutil.copy2(history_db, tmp_history)\n    conn = sqlite3.connect(tmp_history)\n    cursor = conn.cursor()\n    cursor.execute(\"\"\"\n        SELECT url, title, last_visit_time \n        FROM urls \n        WHERE url LIKE '%youtube.com/watch%' OR url LIKE '%youtu.be%'\n        ORDER BY last_visit_time DESC \n        LIMIT 20\n    \"\"\")\n    for url, title, ts in cursor.fetchall():\n        tabs_found.append(('history', url, title))\n    conn.close()\n    os.remove(tmp_history)\nexcept Exception as e:\n    print(f\"History error: {e}\")\n\n# Method 3: Read Session Store\nsession_path = os.path.join(profile, 'Sessions', 'Session_1337755250')\nif not os.path.exists(session_path):\n    # Try finding any session file\n    sessions_dir = os.path.join(profile, 'Sessions')\n    if os.path.exists(sessions_dir):\n        for f in os.listdir(sessions_dir):\n            if f.startswith('Session_'):\n                session_path = os.path.join(sessions_dir, f)\n                break\n\nprint(\"=== YouTube URLs found ===\")\nseen = set()\nfor item in tabs_found:\n    url = item[1]\n    if url not in seen:\n        seen.add(url)\n        if len(item) == 3:\n            print(f\"[{item[0]}] {url} | {item[2]}\")\n        else:\n            print(f\"[{item[0]}] {url}\")\n\nif not seen:\n    print(\"No YouTube URLs found in browser data.\")\n    print(\"Please paste YouTube URLs manually.\")\n"

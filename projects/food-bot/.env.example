# Токен бота — получить у @BotFather в Telegram
BOT_TOKEN=

# LM Studio (Local Server) — обычно можно оставить как есть,
# если сервер запущен на этом же ПК на порту по умолчанию
LMSTUDIO_URL=http://localhost:1234/v1
LMSTUDIO_MODEL=local-model

# Целевые значения из плана питания (раздел "Калораж и БЖУ")
TARGET_KCAL=2350
TARGET_PROTEIN_G=160

# Часовой пояс
TIMEZONE=Europe/Moscow

# Вода
WATER_GLASS_ML=250
WATER_TARGET_ML=2200
WATER_REMINDER_TIMES=11:00,14:30,18:00

# Взвешивание: 0=понедельник ... 6=воскресенье
WEIGHIN_DAY=0
WEIGHIN_TIME=09:00

# Путь к файлу базы (относительно папки проекта)
DB_PATH=food_bot.db

{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "model": "ollama/qwen3.5:latest",
  "mcp": {
    "obsidian": {
      "type": "local",
      "command": ["D:\\AI_Project\\npm-global\\obsidian-mcp-server.cmd"],
      "enabled": true,
      "environment": {
        "OBSIDIAN_API_KEY": "2fda89f1843c614667f350e37a39fdfb1caccf961d410bd5f725cc9b7e086efd"
      }
    }
  },
  "permission": {
    "bash": "allow",
